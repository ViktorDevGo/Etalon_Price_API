# Локальный .env для разработки и тестирования
# Скопируйте в .env и заполните реальными данными

# Application
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug

# Database (для локальной разработки)
DB_DSN=postgres://etalon:etalon_pass@localhost:5432/etalon_price?sslmode=disable

# 4tochki API Credentials
# ВАЖНО: Получите реальные учетные данные у поставщика!
# Контакты: https://www.4tochki.ru/
FOURTOCHKI_WSDL_URL=http://api-b2b.4tochki.ru/WCF/ClientService.svc?wsdl
FOURTOCHKI_LOGIN=YOUR_LOGIN_HERE
FOURTOCHKI_PASSWORD=YOUR_PASSWORD_HERE

# 4tochki API Settings
FOURTOCHKI_BATCH_SIZE=50
FOURTOCHKI_TIMEOUT=60s
FOURTOCHKI_RETRY_COUNT=3
FOURTOCHKI_RETRY_DELAY=5s
FOURTOCHKI_BATCH_DELAY=2s
