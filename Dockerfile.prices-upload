# ================================
# Stage 1: Build Go binaries
# ================================
FROM golang:1.24-alpine AS builder

WORKDIR /build

# Install dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build export commands
RUN go build -o export-bitrix-prices-mrc ./cmd/export-bitrix-prices-mrc
RUN go build -o export-bitrix-prices ./cmd/export-bitrix-prices
RUN go build -o export-bitrix-prices-moto ./cmd/export-bitrix-prices-moto
RUN go build -o export-bitrix-prices-rims ./cmd/export-bitrix-prices-rims

# ================================
# Stage 2: Runtime
# ================================
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache \
    bash \
    dcron \
    openssh-client \
    sshpass \
    tzdata \
    ca-certificates

# Set timezone to Irkutsk
ENV TZ=Asia/Irkutsk
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Create app directory
WORKDIR /app

# Copy binaries from builder
COPY --from=builder /build/export-bitrix-prices-mrc /app/
COPY --from=builder /build/export-bitrix-prices /app/
COPY --from=builder /build/export-bitrix-prices-moto /app/
COPY --from=builder /build/export-bitrix-prices-rims /app/

# Create upload script directly in Dockerfile
RUN cat > /app/upload_prices.sh <<'SCRIPT'
#!/bin/bash
set -e

# Configuration from environment variables
REMOTE_HOST="${BITRIX_REMOTE_HOST:-147.45.215.76}"
REMOTE_USER="${BITRIX_REMOTE_USER:-root}"
REMOTE_PASSWORD="${BITRIX_REMOTE_PASSWORD}"
REMOTE_PATH="${BITRIX_REMOTE_PATH:-/home/bitrix/www/upload/1c_catalog}"
TEMP_DIR="/tmp/bitrix_export"
DATE_STR=$(date +%Y%m%d)

echo "================================================================"
echo "Автоматическая выгрузка цен на сервер 1C-Битрикс"
echo "================================================================"
echo "🕐 Время запуска: $(date '+%Y-%m-%d %H:%M:%S %Z')"
echo ""

# Create temp directory
mkdir -p "$TEMP_DIR"

# Generate price files
echo "📦 Генерация файлов переоценки..."

echo "  → МРЦ..."
/app/export-bitrix-prices-mrc --output-dir="$TEMP_DIR"
if [ $? -ne 0 ]; then echo "❌ Ошибка генерации МРЦ"; exit 1; fi

echo "  → Легковые шины..."
/app/export-bitrix-prices --output-dir="$TEMP_DIR"
if [ $? -ne 0 ]; then echo "❌ Ошибка генерации шин"; exit 1; fi

echo "  → Мотошины..."
/app/export-bitrix-prices-moto --output-dir="$TEMP_DIR"
if [ $? -ne 0 ]; then echo "❌ Ошибка генерации мотошин"; exit 1; fi

echo "  → Диски..."
/app/export-bitrix-prices-rims --output-dir="$TEMP_DIR"
if [ $? -ne 0 ]; then echo "❌ Ошибка генерации дисков"; exit 1; fi

echo "✅ Все файлы сгенерированы"
echo ""

# Upload files
echo "📤 Загрузка файлов на сервер..."

for file in "$TEMP_DIR"/*.csv; do
    filename=$(basename "$file")
    echo "  → Загрузка: $filename"

    sshpass -p "$REMOTE_PASSWORD" scp -o StrictHostKeyChecking=no \
        "$file" \
        "$REMOTE_USER@$REMOTE_HOST:$REMOTE_PATH/"

    if [ $? -eq 0 ]; then
        echo "  ✅ Загружено: $filename"
    else
        echo "  ❌ Ошибка загрузки: $filename"
        exit 1
    fi
done

echo ""
echo "🧹 Очистка временных файлов..."
rm -rf "$TEMP_DIR"

echo ""
echo "================================================================"
echo "✅ Выгрузка завершена успешно!"
echo "🕐 Время завершения: $(date '+%Y-%m-%d %H:%M:%S %Z')"
echo "================================================================"
SCRIPT

# Make script executable
RUN chmod +x /app/upload_prices.sh

# Create cron job (12:00 Irkutsk time daily)
RUN echo "0 12 * * * /app/upload_prices.sh >> /var/log/cron.log 2>&1" > /etc/crontabs/root

# Create log file
RUN touch /var/log/cron.log

# Create startup script
RUN cat > /app/start.sh <<'STARTSCRIPT'
#!/bin/bash
set -e

echo "================================================================"
echo "Prices Upload Scheduler"
echo "================================================================"
echo "Timezone: $(date +%Z)"
echo "Current time: $(date '+%Y-%m-%d %H:%M:%S')"
echo "Schedule: Daily at 12:00 Irkutsk time"
echo "================================================================"
echo ""

# Verify cron is installed
if ! command -v crond &> /dev/null; then
    echo "❌ ERROR: crond not found!"
    exit 1
fi

# Verify crontab exists
if [ ! -f /etc/crontabs/root ]; then
    echo "❌ ERROR: /etc/crontabs/root not found!"
    exit 1
fi

echo "✅ Cron daemon: $(which crond)"
echo "✅ Crontab: /etc/crontabs/root"
echo ""
echo "📋 Cron schedule:"
cat /etc/crontabs/root
echo ""
echo "🚀 Starting cron daemon..."
echo ""

# Start cron in foreground with debug level
exec crond -f -l 2
STARTSCRIPT

RUN chmod +x /app/start.sh

# Expose cron log for monitoring
VOLUME ["/var/log"]

CMD ["/app/start.sh"]
