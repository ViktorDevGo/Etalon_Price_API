# Database Configuration
DATABASE_DSN=postgres://postgres:password@postgres:5432/etalon_price?sslmode=disable
POSTGRES_DB=etalon_price
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# API Server Configuration
API_PORT=8080

# Fourtochki API Configuration
FOURTOCHKI_BASE_URL=https://api.4tochki.ru
FOURTOCHKI_LOGIN=your_fourtochki_login
FOURTOCHKI_PASSWORD=your_fourtochki_password

# Prices Sync Schedule (cron format: minute hour day month weekday)
# Examples:
#   0 */3 * * *  - Every 3 hours (default)
#   0 */6 * * *  - Every 6 hours
#   0 * * * *    - Every hour
#   0 3 * * *    - Every day at 3:00 AM
PRICES_CRON_SCHEDULE=0 */3 * * *

# Timezone (for all services)
TZ=Europe/Moscow

# Email Configuration (for notifications)
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=mail.hosting.reg.ru
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=admin@etalon-shina.ru
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=admin@etalon-shina.ru
EMAIL_NOTIFICATION_TO=v.boyarkin@etalon-shina.ru
