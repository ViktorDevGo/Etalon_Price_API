# Etalon Price API - Configuration Example
# ВАЖНО: Скопируйте этот файл в .env и заполните реальными значениями

# ===========================
# Application Configuration
# ===========================
APP_ENV=production
HTTP_PORT=8080
LOG_LEVEL=info

# ===========================
# Database Configuration
# ===========================
# ВАЖНО: Для Timeweb используйте DATABASE_DSN (НЕ DB_DSN)!
# Формат: postgresql://user:password@host:port/database?sslmode=require
DATABASE_DSN=postgresql://user:password@your-db-host.twc1.net:5432/database?sslmode=require

# ===========================
# Docker Compose (локальная разработка)
# ===========================
POSTGRES_DB=etalon_price
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432
DB_DSN=postgres://postgres:your_secure_password_here@postgres:5432/etalon_price?sslmode=disable

# ===========================
# 4tochki API Configuration
# ===========================
FOURTOCHKI_WSDL_URL=http://api-b2b.4tochki.ru/WCF/ClientService.svc?wsdl
FOURTOCHKI_BASE_URL=http://api-b2b.4tochki.ru/WCF/ClientService.svc?wsdl
FOURTOCHKI_LOGIN=your_login
FOURTOCHKI_PASSWORD=your_password

# 4tochki API Settings (опционально)
FOURTOCHKI_BATCH_SIZE=50
FOURTOCHKI_TIMEOUT=60s
FOURTOCHKI_RETRY_COUNT=3
FOURTOCHKI_RETRY_DELAY=5s
FOURTOCHKI_BATCH_DELAY=2s

# ===========================
# Северавто API Configuration
# ===========================
SEVERAVTO_BASE_URL=https://webmim.svrauto.ru
SEVERAVTO_API_KEY=your_api_key_from_personal_cabinet
SEVERAVTO_EMAIL=zakupki@etalon-shina.ru
SEVERAVTO_PASSWORD=Qwaszx1010!
SEVERAVTO_TIMEOUT=60s

# ===========================
# Scheduler Configuration
# ===========================
# Prices Sync Schedule (cron format: minute hour day month weekday)
# Examples:
#   0 */3 * * *  - Every 3 hours (default)
#   0 */6 * * *  - Every 6 hours
#   0 * * * *    - Every hour
#   0 3 * * *    - Every day at 3:00 AM
PRICES_CRON_SCHEDULE=0 */3 * * *

# ===========================
# Email Configuration
# ===========================
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=mail.hosting.reg.ru
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=admin@etalon-shina.ru
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=admin@etalon-shina.ru
EMAIL_NOTIFICATION_TO=recipient@example.com

# ===========================
# Timezone Configuration
# ===========================
# Europe/Moscow для API и планировщиков
# Asia/Irkutsk для prices-upload
TZ=Europe/Moscow

# ===========================
# Bitrix Upload (prices-upload)
# ===========================
WORK_DIR=/app
