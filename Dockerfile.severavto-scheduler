# Severavto Scheduler - синхронизация каждые 3 часа (шины :00, диски :15)
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build severavto-scheduler binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o /app/severavto-scheduler \
    ./cmd/severavto-scheduler

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary
COPY --from=builder /app/severavto-scheduler .

# Copy migrations
COPY migrations ./migrations

# Set timezone to Moscow
ENV TZ=Europe/Moscow

# The binary contains the scheduler logic (cron)
# It will run continuously and execute sync at scheduled times
CMD ["./severavto-scheduler"]
